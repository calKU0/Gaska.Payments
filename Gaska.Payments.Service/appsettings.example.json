{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Gaska.Payments": "Debug",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/automat-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 62,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/automat-errors-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 62,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Erp": {
    "ConnectionString": "Server=<serwer>;Database=<baza>;User Id=<uzytkownik>;Password=<haslo>;TrustServerCertificate=True;Encrypt=True",
    "OwnNip": "<NIP firmy>"
  },
  "Bnp": {
    "Endpoint": "<adres uslugi banku>",
    "CertificatePath": "Certificates\\<plik>.pfx",
    "CertificatePassword": "<haslo certyfikatu>",
    "MaxDaysPerRequest": 7,
    "StatementBackfillDays": 7
  },
  "Archive": {
    "Directory": "<sciezka do archiwum>"
  },
  "Cod": {
    "Enabled": true,
    "Register": "K_GLS",
    "OperationSymbol": "KP_PL",
    "PostFrom": "2026-08-21",
    "MaxMessagesPerRun": 100,
    "PayoutWindowDays": 30,
    "Mailbox": {
      "Host": "<serwer poczty>",
      "Port": 995,
      "UseSsl": true,
      "User": "<uzytkownik>",
      "Password": "<haslo>",
      "DeleteAfterDownload": false
    },
    "Notifications": {
      "Host": "<serwer poczty>",
      "Port": 465,
      "UseSsl": true,
      "User": "<uzytkownik>",
      "Password": "<haslo>",
      "From": "<adres nadawcy>",
      "Recipients": [
        "<adres odbiorcy>"
      ]
    },
    "Couriers": [
      {
        "Name": "GLS",
        "Format": "GlsCsv",
        "Senders": [],
        "Accounts": []
      },
      {
        "Name": "DPD",
        "Format": "DpdXls",
        "Senders": [
          "specyfikacja_cod@dpd.com.pl"
        ],
        "Accounts": []
      },
      {
        "Name": "Fedex",
        "Format": "FedexReport",
        "Senders": [
          "PolandCOD@fedex.com"
        ],
        "Accounts": [
          "06160011980002002332681001"
        ]
      }
    ]
  },
  "Settlement": {
    "IntervalMinutes": 60,
    "LookbackDays": 7,
    "ReceivablesLookbackMonths": 18,
    "EnsureSchemaOnStartup": true,
    "Registers": [
      "FORPL",
      "FORUE",
      "FORUS",
      "FORRO",
      "FORVA"
    ],
    "CardRegisters": [
      "KART1",
      "KART3",
      "KART4",
      "KART5",
      "FORKO",
      "FORKG"
    ],
    "PostOnlyRegisters": [
      "ZF\u015aS",
      "FORZU",
      "FORD2"
    ],
    "OwnContractorAcronym": "<akronim wlasnej kartoteki>"
  },
  "Xl": {
    "Database": "<baza ERP>",
    "Operator": "<operator ERP>",
    "Password": "<haslo>",
    "ApiVersion": 20251,
    "ToBuffer": false,
    "PostFrom": "2026-08-20",
    "MaxOperationsPerRun": 1000,
    "FeeOperation": "PRW"
  }
}
