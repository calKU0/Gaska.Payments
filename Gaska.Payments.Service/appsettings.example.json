{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Gaska.Payments": "Debug",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/automat-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 62,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/automat-errors-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 62,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "<adres serwera Seq>",
          "apiKey": "<klucz API Seq>",
          "restrictedToMinimumLevel": "Debug",
          "bufferBaseFilename": "logs/seq-buffer",
          "bufferSizeLimitBytes": 268435456
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Gaska.Payments.Service"
    }
  },
  "SerilogEmail": {
    "From": "<adres nadawcy>",
    "To": "<odbiorcy, rozdzieleni srednikiem>",
    "MailServer": "<serwer poczty>",
    "Port": 587,
    "EnableSsl": true,
    "Username": "<uzytkownik>",
    "Password": "<haslo>",
    "Subject": "Gaska.Payments.Service",
    "MinimumLevel": "Warning",
    "BatchPostingLimit": 100,
    "BatchPostingPeriodMinutes": 60
  },
  "Erp": {
    "ConnectionString": "Server=<serwer>;Database=<baza>;User Id=<uzytkownik>;Password=<haslo>;TrustServerCertificate=True;Encrypt=True",
    "OwnNip": "<NIP firmy>"
  },
  "Bnp": {
    "Endpoint": "<adres uslugi banku>",
    "CertificatePath": "Certificates\\<plik>.pfx",
    "CertificatePassword": "<haslo certyfikatu>",
    "MaxDaysPerRequest": 7,
    "StatementBackfillDays": 7
  },
  "Archive": {
    "Directory": "<sciezka do archiwum>"
  },
  "Cod": {
    "Enabled": true,
    "Register": "K_GLS",
    "OperationSymbol": "KP_PL",
    "PostFrom": "2026-08-21",
    "MaxMessagesPerRun": 100,
    "PayoutWindowDays": 30,
    "Mailbox": {
      "Host": "<serwer poczty>",
      "Port": 995,
      "UseSsl": true,
      "User": "<uzytkownik>",
      "Password": "<haslo>",
      "DeleteAfterDownload": false
    },
    "Notifications": {
      "Host": "<serwer poczty>",
      "Port": 465,
      "UseSsl": true,
      "User": "<uzytkownik>",
      "Password": "<haslo>",
      "From": "<adres nadawcy>",
      "Recipients": [
        "<adres odbiorcy>"
      ]
    },
    "Couriers": [
      {
        "Name": "GLS",
        "Format": "GlsCsv",
        "Senders": [
          "cod@gls-poland.com.pl"
        ],
        "Accounts": []
      },
      {
        "Name": "DPD",
        "Format": "DpdXls",
        "Senders": [
          "specyfikacja_cod@dpd.com.pl"
        ],
        "Accounts": []
      },
      {
        "Name": "Hellmann",
        "Format": "HellmannXlsx",
        "Senders": [
          "hellmann.com",
          "it@gaska.com.pl"
        ],
        "Accounts": []
      },
      {
        "Name": "Diera",
        "Format": "DieraXlsx",
        "Senders": [
          "diera.pl",
          "it@gaska.com.pl"
        ],
        "Accounts": []
      },
      {
        "Name": "Fedex",
        "Format": "FedexReport",
        "Senders": [
          "PolandCOD@fedex.com"
        ],
        "Accounts": [
          "06160011980002002332681001"
        ]
      }
    ]
  },
  "Cards": {
    "Enabled": true,
    "Register": "KARTA",
    "SaleOperation": "KP-K",
    "RefundOperation": "KW-K",
    "FeeOperation": "PROW",
    "FeeContractorId": 11724,
    "PostFrom": "2026-09-10",
    "Senders": [
      "polcard.com.pl",
      "it@gaska.com.pl"
    ],
    "DocumentWindowDays": 7,
    "PayoutRegisters": [
      "FORPL"
    ],
    "PayoutWindowDays": 14,
    "MaximumCommissionShare": 0.05
  },
  "Advisor": {
    "Enabled": true,
    "Url": "<adres webhooka n8n>",
    "TimeoutMinutes": 30,
    "PollSeconds": 60,
    "LookbackDays": 14,
    "MaxAttempts": 3,
    "RetryAfterMinutes": 30,
    "Confidences": [ "None", "Low" ],
    "ExcludedContractorIds": [ 6967, 7374, 39711, 51575, 2114, 57669 ]
  },
  "Settlement": {
    "IntervalMinutes": 60,
    "LookbackDays": 7,
    "ReceivablesLookbackMonths": 18,
    "EnsureSchemaOnStartup": true,
    "Registers": [
      "FORPL",
      "FORUE",
      "FORUS",
      "FORRO",
      "FORVA"
    ],
    "CardRegisters": [
      "KART1",
      "KART3",
      "KART4",
      "KART5",
      "FORKO",
      "FORKG"
    ],
    "PostOnlyRegisters": [
      "ZF\u015aS",
      "FORZU",
      "FORD2"
    ],
    "OwnContractorAcronym": "<akronim wlasnej kartoteki>"
  },
  "Xl": {
    "Database": "<baza ERP>",
    "Operator": "<operator ERP>",
    "Password": "<haslo>",
    "ApiVersion": 20251,
    "ToBuffer": false,
    "PostFrom": "2026-08-20",
    "MaxOperationsPerRun": 1000,
    "FeeOperation": "PRW"
  }
}
