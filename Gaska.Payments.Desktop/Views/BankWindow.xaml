<Window x:Class="Gaska.Payments.Desktop.Views.BankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank do rachunku"
        Icon="/rozliczanie.ico"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Canvas}">

    <!--
        Zawartość w ScrollViewerze, a wysokość okna ograniczona do ekranu (BankWindow.xaml.cs).
        Księgowość pracuje na mniejszych monitorach, a przy skalowaniu Windows 125-150% formularz
        w naturalnej wysokości nie mieści się na 1366x768 - bez tego przyciski na dole zostawały
        pod krawędzią ekranu, a okna nie da się ani zmniejszyć, ani przewinąć.
    -->
    <Border Style="{StaticResource Card}" Margin="16" Padding="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
            <TextBlock x:Name="IntroText" Style="{StaticResource Subtle}" TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Numer rachunku" Style="{StaticResource Label}" Margin="0,0,0,5" />
                        <TextBox x:Name="AccountBox" Style="{StaticResource SelectableMono}" FontSize="14.5" />
                    </StackPanel>

                    <!--
                        Dane banku z publicznego rejestru IBAN. Otwiera stronę obok formularza i
                        przepisuje z niej, co poda; okno zostaje otwarte, żeby operator mógł
                        porównać. Zamyka się razem z tym formularzem.
                    -->
                    <Button x:Name="LookupButton" Grid.Column="1" Content="Pobierz dane z sieci"
                            Style="{StaticResource Btn}" MinWidth="0" Padding="14,6" Margin="12,0,0,0"
                            VerticalAlignment="Bottom" Click="OnLookUp"
                            ToolTip="Sprawdza numer na pl.ibancalculator.com i wypełnia pola poniżej." />
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Numer kierunkowy banku" Style="{StaticResource Label}" />
                    <TextBox x:Name="BankCodeBox" CharacterCasing="Upper" MaxLength="20"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="SWIFT / BIC" Style="{StaticResource Label}" />
                    <TextBox x:Name="BicBox" CharacterCasing="Upper" MaxLength="11"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Kraj" Style="{StaticResource Label}" />
                    <TextBox x:Name="CountryBox" CharacterCasing="Upper" MaxLength="2"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Nazwa banku" Style="{StaticResource Label}" Margin="0,14,0,2" />
            <TextBox x:Name="NameBox" MaxLength="100" VerticalContentAlignment="Center" />

            <TextBlock Text="Ulica (opcjonalnie)" Style="{StaticResource Label}" Margin="0,14,0,2" />
            <TextBox x:Name="StreetBox" MaxLength="60" VerticalContentAlignment="Center" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="134" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Miasto" Style="{StaticResource Label}" />
                    <TextBox x:Name="CityBox" MaxLength="40" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kod pocztowy" Style="{StaticResource Label}" />
                    <TextBox x:Name="PostalCodeBox" MaxLength="10" VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="SourceText" Style="{StaticResource Subtle}" Margin="0,12,0,0"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontSize="13"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Pomiń" Style="{StaticResource Btn}" MinWidth="112" Margin="0,0,10,0"
                        Click="OnCancel" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Primary}" MinWidth="168"
                        Click="OnConfirm" IsDefault="True" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
