<Window x:Class="Gaska.Payments.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mvvm="clr-namespace:Gaska.Payments.Desktop.Mvvm"
        Title="Rozliczanie przelewów"
        Icon="/rozliczanie.ico"
        Width="1660" Height="980" MinWidth="1180" MinHeight="740"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}">

    <Window.Resources>
        <!-- Grid columns are not in the visual tree, so they do not inherit DataContext.
             This proxy lets a header reach the view model. -->
        <mvvm:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />

        <mvvm:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

        <!-- The badge colour follows from the confidence level: green only for certain
             payments, amber for the ones somebody has to look at. -->
        <Style x:Key="ConfidenceBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="#F1F2F4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Confidence}" Value="High">
                    <Setter Property="Background" Value="{StaticResource GoodSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Confidence}" Value="Medium">
                    <Setter Property="Background" Value="{StaticResource WarnSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Confidence}" Value="Low">
                    <Setter Property="Background" Value="{StaticResource BadSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfidenceBadgeText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Confidence}" Value="High">
                    <Setter Property="Foreground" Value="{StaticResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Confidence}" Value="Medium">
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Confidence}" Value="Low">
                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <!--
            Flags drawn as shapes rather than emoji: Windows does not render country flag emoji and puts
            two letters in a box in their place. The size is small, so the shapes are simplified - the
            point is to tell the registers apart out of the corner of an eye.
        -->
        <DataTemplate x:Key="FlagPL">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Rectangle Fill="#FFFFFF" />
                <Rectangle Grid.Row="1" Fill="#DC143C" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlagRO">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#002B7F" />
                <Rectangle Grid.Column="1" Fill="#FCD116" />
                <Rectangle Grid.Column="2" Fill="#CE1126" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FlagUS">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Rectangle Fill="#B22234" />
                <Rectangle Grid.Row="1" Fill="#FFFFFF" />
                <Rectangle Grid.Row="2" Fill="#B22234" />
                <Rectangle Grid.Row="3" Fill="#FFFFFF" />
                <Rectangle Grid.Row="4" Fill="#B22234" />
                <Rectangle Grid.Row="5" Fill="#FFFFFF" />
                <Rectangle Grid.Row="6" Fill="#B22234" />
                <Rectangle Grid.RowSpan="4" Fill="#3C3B6E" Width="9"
                           HorizontalAlignment="Left" VerticalAlignment="Stretch" />
            </Grid>
        </DataTemplate>

        <!-- A wreath of twelve stars blurs into a smudge at this scale, so one star it is. -->
        <DataTemplate x:Key="FlagEU">
            <Grid Background="#003399">
                <TextBlock Text="★" Foreground="#FFCC00" FontSize="9" Margin="0,-1,0,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!--
            A credit card account. There is no flag worth showing here - every card is in zloty, and the
            point is to tell them from the current accounts at a glance.
        -->
        <DataTemplate x:Key="CardIcon">
            <Grid>
                <Rectangle Fill="#3D5A98" RadiusX="2" RadiusY="2" />
                <Rectangle Fill="#22355E" Height="3" VerticalAlignment="Top" Margin="0,2,0,0" />
                <Rectangle Fill="#F2C94C" Width="4" Height="3" RadiusX="1" RadiusY="1"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2" />
            </Grid>
        </DataTemplate>

        <!--
            Pobrania za paczki. Ten rejestr to kasa, nie rachunek bankowy - flaga byłaby nieprawdą,
            więc rysujemy paczkę: pudełko przewiązane taśmą.
        -->
        <DataTemplate x:Key="ParcelIcon">
            <Grid>
                <Rectangle Fill="#C8A165" RadiusX="2" RadiusY="2" />
                <Rectangle Fill="#8C6D3F" Width="3" HorizontalAlignment="Center" />
                <Rectangle Fill="#8C6D3F" Height="2" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!--
            The icon is chosen by content rather than by field name, so that the same style serves both
            the transfer list and the filter - both sides supply the icon code alone.
        -->
        <Style x:Key="RegisterIcon" TargetType="ContentControl">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Content" Value="PL">
                    <Setter Property="ContentTemplate" Value="{StaticResource FlagPL}" />
                </Trigger>
                <Trigger Property="Content" Value="RO">
                    <Setter Property="ContentTemplate" Value="{StaticResource FlagRO}" />
                </Trigger>
                <Trigger Property="Content" Value="US">
                    <Setter Property="ContentTemplate" Value="{StaticResource FlagUS}" />
                </Trigger>
                <Trigger Property="Content" Value="EU">
                    <Setter Property="ContentTemplate" Value="{StaticResource FlagEU}" />
                </Trigger>
                <Trigger Property="Content" Value="CARD">
                    <Setter Property="ContentTemplate" Value="{StaticResource CardIcon}" />
                </Trigger>
                <Trigger Property="Content" Value="PARCEL">
                    <Setter Property="ContentTemplate" Value="{StaticResource ParcelIcon}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The icon in a frame: the white bands of the Polish flag would otherwise vanish
             against a light background. -->
        <Style x:Key="IconFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="#C8CDD4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- An ordinary multiple-choice filter entry - the label alone. -->
        <DataTemplate x:Key="FilterEntry">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,4" />
        </DataTemplate>

        <!-- A register filter entry - with the icon, the same one the list column uses. -->
        <DataTemplate x:Key="RegisterEntry">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource IconFrame}"
                            Visibility="{Binding Icon, Converter={StaticResource EmptyToCollapsed}}">
                        <ContentControl Content="{Binding Icon}" Style="{StaticResource RegisterIcon}" />
                    </Border>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="7,0,0,0" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <!-- A confidence filter entry - the same badges the list column uses. -->
        <DataTemplate x:Key="ConfidenceEntry">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,4">
                <Border Style="{StaticResource ConfidenceBadge}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource ConfidenceBadgeText}" />
                </Border>
            </CheckBox>
        </DataTemplate>

    <!--
        The settlement state is read by colour: green is closed, amber begun, grey untouched. The
        same set of shades as on match confidence.
    -->
    <Style x:Key="StateBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="#F1F2F4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SettlementState}" Value="Settled">
                <Setter Property="Background" Value="{StaticResource GoodSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SettlementState}" Value="Partial">
                <Setter Property="Background" Value="{StaticResource WarnSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StateBadgeText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SettlementState}" Value="Settled">
                <Setter Property="Foreground" Value="{StaticResource Good}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SettlementState}" Value="Partial">
                <Setter Property="Foreground" Value="{StaticResource Warn}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A document row is coloured by its side of the ledger: receivables green, liabilities and
        corrections red. The shades are barely visible so as not to shout - the "Strona" column says
        the same thing in words, and the colour is only there to speed up reading the list.
    -->
    <Style x:Key="DocumentRow" TargetType="DataGridRow">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Row.IsLiability}" Value="False">
                <Setter Property="Background" Value="#F2FBF5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Row.IsLiability}" Value="True">
                <Setter Property="Background" Value="#FEF4F4" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    </Window.Resources>

    <Grid>
      <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================= header ============================ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Rozliczanie przelewów" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Subtle}" Margin="0,3,0,0">
                    <Run Text="{Binding Header, Mode=OneWay}" />
                    <Run Text=" · w kolejce " />
                    <Run Text="{Binding QueueCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" przelewów na " />
                    <Run Text="{Binding QueueTotal, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Odśwież" Style="{StaticResource Btn}" Command="{Binding RefreshCommand}"
                        MinWidth="112" Margin="0,0,10,0" />
                <Button Content="Oznacz: nie rozliczaj" Style="{StaticResource Btn}" MinWidth="200"
                        Margin="0,0,10,0" Command="{Binding DoNotSettleCommand}"
                        ToolTip="Ustawia w ERP znacznik „nie podlega rozliczeniu” – dla prowizji, zwrotów i przeksięgowań. Działa na zaznaczonych przelewach, a gdy nic nie zaznaczono, na bieżącym. Przelewy już częściowo rozliczone pomija." />
                <Button MinWidth="240" Style="{StaticResource Primary}"
                        Command="{Binding SettleCheckedCommand}"
                        ToolTip="Rozlicza zaznaczone przelewy, każdy z jego wybranymi dokumentami.">
                    <TextBlock>
                        <Run Text="Rozlicz zaznaczone (" /><Run
                            Text="{Binding CheckedCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================= filters ============================ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,14">
            <!--
                There are seven filters and on a narrower screen they did not fit in one row - the last of
                them (the date) were simply cut off, because a grid neither scrolls nor wraps. A WrapPanel
                moves them to a second row instead of hiding them.
            -->
            <WrapPanel Orientation="Horizontal">
                <TextBox Width="290" Margin="0,3,18,3" VerticalContentAlignment="Center"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         ToolTip="Szuka w nazwie nadawcy, tytule przelewu, kontrahencie i kwocie." />

                <StackPanel Orientation="Horizontal" Margin="0,3,18,3" VerticalAlignment="Center">
                    <TextBlock Text="Kierunek" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <HeaderedItemsControl Style="{StaticResource MultiSelectFilter}" MinWidth="170"
                                          Header="{Binding DirectionFilterSummary}"
                                          ItemsSource="{Binding DirectionFilters}"
                                          ItemTemplate="{StaticResource FilterEntry}"
                                          ToolTip="Wpłaty rozliczają należności, wypłaty zobowiązania." />

                    <TextBlock Text="Pewność" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="18,0,8,0" />
                    <HeaderedItemsControl Style="{StaticResource MultiSelectFilter}" MinWidth="200"
                                          Header="{Binding ConfidenceFilterSummary}"
                                          ItemsSource="{Binding ConfidenceFilters}"
                                          ItemTemplate="{StaticResource ConfidenceEntry}"
                                          ToolTip="Na ile silnik jest pewien podpowiedzi. Pewne wpłaty zamyka automat." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,3,18,3" VerticalAlignment="Center">
                    <TextBlock Text="Rejestr" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <HeaderedItemsControl Style="{StaticResource MultiSelectFilter}" MinWidth="190"
                                          Header="{Binding RegisterFilterSummary}"
                                          ItemsSource="{Binding RegisterFilters}"
                                          ItemTemplate="{StaticResource RegisterEntry}"
                                          ToolTip="Rejestry kart kredytowych są domyślnie odznaczone – na kartach nie ma czego rozliczać, są tu tylko do podejrzenia." />

                    <TextBlock Text="Stan rozliczenia" Style="{StaticResource Subtle}"
                               VerticalAlignment="Center" Margin="18,0,8,0" />
                    <HeaderedItemsControl Style="{StaticResource MultiSelectFilter}" MinWidth="235"
                                          Header="{Binding SettlementFilterSummary}"
                                          ItemsSource="{Binding SettlementFilters}"
                                          ItemTemplate="{StaticResource FilterEntry}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,3,18,3" VerticalAlignment="Center">
                    <TextBlock Text="Od dnia" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding From}" MinWidth="155"
                                ToolTip="Zakres wczytywany z bazy. Po zmianie kliknij Odśwież." />
                </StackPanel>

                <CheckBox Content="tylko z podpowiedziami" VerticalAlignment="Center" Margin="0,3"
                          IsChecked="{Binding OnlySuggested}"
                          ToolTip="Zostawia przelewy, dla których silnik cokolwiek zaproponował." />
            </WrapPanel>
        </Border>

        <!-- ==================== queue and row details ====================== -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="330" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" Style="{StaticResource Table}"
                      ColumnHeaderStyle="{StaticResource ColumnHeader}"
                      CellStyle="{StaticResource Cell}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      FrozenColumnCount="2"
                      ItemsSource="{Binding View}" SelectedItem="{Binding Selected}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" MinWidth="44" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Data" Width="98" MinWidth="98"
                                        Binding="{Binding BookingDate, StringFormat=dd.MM.yyyy}"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTemplateColumn Header="Rejestr" Width="114" MinWidth="114" SortMemberPath="RegisterSeries">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                    <Border Style="{StaticResource IconFrame}"
                                            Visibility="{Binding RegisterIcon,
                                                                 Converter={StaticResource EmptyToCollapsed}}">
                                        <ContentControl Content="{Binding RegisterIcon}"
                                                        Style="{StaticResource RegisterIcon}" />
                                    </Border>
                                    <TextBlock Text="{Binding RegisterSeries}" Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CellText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kier." Width="84" MinWidth="80" Binding="{Binding DirectionLabel}"
                                        ElementStyle="{StaticResource CellText}" />

                    <DataGridTextColumn Width="125" MinWidth="116"
                                        Binding="{Binding Amount, StringFormat={}{0:N2}}"
                                        ElementStyle="{StaticResource MoneyCell}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Kwota" Style="{StaticResource HeaderTextRight}" Margin="0,0,8,0" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="125" MinWidth="116"
                                        Binding="{Binding Remaining, StringFormat={}{0:N2}}"
                                        ElementStyle="{StaticResource MoneyCell}">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Pozostało" Style="{StaticResource HeaderTextRight}" Margin="0,0,8,0"
                                       ToolTip="Ile z przelewu nie jest jeszcze rozliczone w ERP." />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Waluta" Width="78" MinWidth="74" Binding="{Binding Currency}"
                                        ElementStyle="{StaticResource CellText}" />

                    <DataGridTextColumn Width="232" MinWidth="165" Binding="{Binding PayerName}"
                                        ElementStyle="{StaticResource CellText}"
                                        Header="{Binding Data.PartyHeader, Source={StaticResource ViewModelProxy}}" />

                    <DataGridTextColumn Header="Kontrahent ERP" Width="146" MinWidth="124" Binding="{Binding ContractorAcronym}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="ToolTip" Value="{Binding ContractorDisplay}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Rozpoznany po" Width="190" MinWidth="146" Binding="{Binding ContractorSourceLabel}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding ContractorSourceLabel}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Stan rozliczenia" Width="172" MinWidth="172"
                                            SortMemberPath="SettlementState">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StateBadge}" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SettlementLabel}"
                                               Style="{StaticResource StateBadgeText}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Pewność" Width="140" MinWidth="140" SortMemberPath="Confidence">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ConfidenceBadge}" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ConfidenceLabel}" Style="{StaticResource ConfidenceBadgeText}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Tytuł przelewu" Width="*" MinWidth="220" Binding="{Binding Description}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Description}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Ostatnia próba" Width="156" MinWidth="134" Binding="{Binding LastResult}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding LastResult}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalSplitter}" />

            <!-- ============================ details ============================ -->
            <!--
                The side panels have a fixed width because their content does not stretch: they hold labels
                and buttons. All the surplus goes to the middle, where the document list stands - that is the
                one with nine columns and the one that was cramped on smaller screens.
                The splitters between the panels let the boundaries be moved when somebody prefers otherwise.
            -->
            <Grid Grid.Row="2" IsEnabled="{Binding HasSelection}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="312" MinWidth="256" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" MinWidth="256" />
                </Grid.ColumnDefinitions>

                <!-- left: what came from the bank -->
                <Border Style="{StaticResource Card}" Padding="16,14,6,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel DataContext="{Binding Selected}">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Przelew" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                <!--
                                    Wyciąg albo zestawienie pobrań, z którego wzięła się operacja.
                                    Przycisk pokazuje się tylko wtedy, gdy plik naprawdę leży w
                                    archiwum - martwy przycisk gorszy niż jego brak.
                                -->
                                <Button Content="{Binding SourceDocumentLabel}"
                                        Style="{StaticResource Btn}" MinWidth="0" Padding="10,4"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenSourceDocumentCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding HasSourceDocument,
                                                     Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{Binding SourceDocument}" />
                            </Grid>

                            <!--
                                Tytuł stoi zaraz pod nagłówkiem, bo jest najdłuższym i najczęściej
                                czytanym polem panelu. Niżej wypadał pod krawędź i trzeba było go
                                szukać suwakiem. Pole zawija się i nie ma ograniczenia wysokości -
                                cały opis jest widoczny, bez skracania wielokropkiem.
                            -->
                            <TextBlock Text="Tytuł" Style="{StaticResource Label}" />
                            <Border Background="{StaticResource Canvas}" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <TextBox Text="{Binding Description, Mode=OneWay}"
                                         Style="{StaticResource SelectableMono}"
                                         TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding PartyLabel}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding PayerName, Mode=OneWay}" Style="{StaticResource Selectable}"
                                     Margin="0,0,0,12" />

                            <TextBlock Text="{Binding PartyAccountLabel}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Row.PayerAccount, Mode=OneWay}"
                                     Style="{StaticResource SelectableMono}" Margin="0,0,0,12" />

                            <TextBlock Text="Kontrahent w ERP" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ContractorDisplay, Mode=OneWay}"
                                     Style="{StaticResource Selectable}" />
                            <TextBlock Text="{Binding ContractorSourceLabel}" Style="{StaticResource Subtle}" Margin="0,0,0,12" />

                            <TextBlock Text="Dlaczego taka klasyfikacja" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Notes, Mode=OneWay}" Style="{StaticResource Selectable}"
                                     Foreground="{StaticResource Muted}" Margin="0,0,0,12" />

                            <TextBlock Text="Sposób dopasowania" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding StrategyLabel}" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

                <!-- middle: the documents to settle against -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14,16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Nierozliczone dokumenty kontrahenta" Style="{StaticResource H2}"
                                       VerticalAlignment="Center" Margin="0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="12" Height="12" CornerRadius="3" Background="#F2FBF5"
                                        BorderBrush="#BFE3CC" BorderThickness="1" VerticalAlignment="Center" />
                                <TextBlock Text="należność" Style="{StaticResource Subtle}"
                                           VerticalAlignment="Center" Margin="6,0,16,0" />

                                <Border Width="12" Height="12" CornerRadius="3" Background="#FEF4F4"
                                        BorderBrush="#F0C9C9" BorderThickness="1" VerticalAlignment="Center" />
                                <TextBlock Text="zobowiązanie" Style="{StaticResource Subtle}"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" Style="{StaticResource Table}"
                                  ColumnHeaderStyle="{StaticResource ColumnHeader}"
                                  CellStyle="{StaticResource Cell}"
                                  RowStyle="{StaticResource DocumentRow}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  FrozenColumnCount="2"
                                  ItemsSource="{Binding Selected.Documents}" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" MinWidth="44" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Dokument" Width="190" MinWidth="134" Binding="{Binding DocNumber}"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Typ" Width="66" MinWidth="60" Binding="{Binding Symbol}"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Strona" Width="108" MinWidth="96" Binding="{Binding Kind}"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Waluta" Width="78" MinWidth="72" Binding="{Binding Currency}"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Width="120" MinWidth="110"
                                                    Binding="{Binding Remaining, StringFormat={}{0:N2}}"
                                                    ElementStyle="{StaticResource MoneyCell}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="Pozostaje" Style="{StaticResource HeaderTextRight}"
                                                   Margin="0,0,8,0" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Numer u kontrahenta" Width="168" MinWidth="124"
                                                    Binding="{Binding ForeignNumber}"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Termin" Width="162" MinWidth="124" Binding="{Binding DueLabel}"
                                                    SortMemberPath="DueDate"
                                                    ElementStyle="{StaticResource CellText}" />

                                <DataGridTemplateColumn Header="Podpowiedź serwisu" Width="*" MinWidth="124">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}" Margin="10,0,0,0"
                                                    ToolTip="Ten dokument przypisał do przelewu silnik dopasowania – dlatego jest zaznaczony."
                                                    Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="dopasował serwis" Style="{StaticResource BadgeText}"
                                                           Foreground="{StaticResource Accent}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- summary: whether it balances has to be visible at a glance -->
                        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="6" Padding="14,10"
                                Background="{StaticResource Canvas}" DataContext="{Binding Selected}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Kwota przelewu" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N2}}"
                                               Style="{StaticResource Money}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Pozostało" Style="{StaticResource Label}"
                                               ToolTip="Ile z przelewu nie jest jeszcze rozliczone w ERP." />
                                    <TextBlock Text="{Binding Remaining, StringFormat={}{0:N2}}"
                                               Style="{StaticResource Money}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Należności" Style="{StaticResource Label}"
                                               ToolTip="Suma zaznaczonych dokumentów po stronie należności." />
                                    <TextBlock Text="{Binding SelectedInvoices, StringFormat={}{0:N2}}"
                                               Style="{StaticResource Money}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Zobowiązania" Style="{StaticResource Label}"
                                               ToolTip="Suma zaznaczonych dokumentów po stronie zobowiązań." />
                                    <TextBlock Text="{Binding SelectedLiabilities, StringFormat={}−{0:N2}}"
                                               Style="{StaticResource Money}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Margin="0,0,30,0">
                                    <TextBlock Text="Zostanie rozliczone" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding SelectedNet, StringFormat={}{0:N2}}"
                                               Style="{StaticResource Money}" HorizontalAlignment="Left"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Do rozliczenia" Style="{StaticResource Label}" />
                                    <TextBlock Style="{StaticResource Money}" HorizontalAlignment="Left"
                                               FontWeight="SemiBold"
                                               ToolTip="Ile z przelewu zostanie nierozliczone po zaznaczonych dokumentach."
                                               Text="{Binding Difference, StringFormat={}{0:N2}}">
                                        <TextBlock.Foreground>
                                            <Binding Path="IsBalanced" Converter="{StaticResource BoolToBrush}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" Style="{StaticResource VerticalSplitter}" />

                <!-- right: tools and decisions -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14,6,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Zły kontrahent?" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Wyszukaj właściwego – lista dokumentów przeładuje się na jego rozrachunki." />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox VerticalContentAlignment="Center"
                                         Text="{Binding ContractorQuery, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Akronim, nazwa albo NIP." />
                                <Button Grid.Column="1" Content="Szukaj" Margin="8,0,0,0"
                                        Style="{StaticResource Small}" Command="{Binding FindContractorCommand}" />
                            </Grid>

                            <ListBox x:Name="ContractorHits" ItemsSource="{Binding ContractorHits}"
                                     MaxHeight="170" Margin="0,0,0,10"
                                     BorderBrush="{StaticResource Line}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Acronym}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Subtle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Content="Pokaż jego dokumenty" Margin="0,0,0,20"
                                    Style="{StaticResource Wide}"
                                    Command="{Binding UseContractorCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=ContractorHits}" />

                            <Button Content="Wróć do podpowiedzi serwisu" Margin="0,0,0,10"
                                    Style="{StaticResource Wide}"
                                    Command="{Binding RestoreContractorCommand}"
                                    Visibility="{Binding Selected.ContractorOverridden,
                                                         Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Cofa ręczną podmianę kontrahenta i wraca do tego, co wyliczył serwis." />

                            <Button Content="Przypisz rachunek do kontrahenta" Margin="0,0,0,20"
                                    Style="{StaticResource Wide}"
                                    Command="{Binding AssignAccountCommand}"
                                    ToolTip="Dopisuje rachunek bankowy z tego przelewu do kartoteki wybranego kontrahenta. Kolejny przelew z tego konta serwis rozpozna sam. Nieaktywne, gdy rachunek już jest przypisany." />

                            <TextBlock Text="Dołącz dokument po numerze" Style="{StaticResource H2}" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox VerticalContentAlignment="Center"
                                         Text="{Binding DocumentQuery, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Sam numer, na przykład 33575." />
                                <Button Grid.Column="1" Content="Dołącz" Margin="8,0,0,0"
                                        Style="{StaticResource Small}" Command="{Binding FindDocumentCommand}" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,18" />

                            <Button Content="Rozlicz ten przelew" Margin="0,0,0,10"
                                    Style="{StaticResource PrimaryWide}"
                                    Command="{Binding SettleCurrentCommand}" />

                            <!--
                                Shown only on an untouched entry: the "not subject to settlement" flag contradicts somebody
                                having already matched part of the amount to something.
                            -->
                            <Button Content="Oznacz: nie rozliczaj" Margin="0,0,0,10"
                                    Style="{StaticResource Wide}"
                                    Command="{Binding DoNotSettleCommand}"
                                    Visibility="{Binding Selected.CanMarkDoNotSettle,
                                                         Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Ustawia w ERP znacznik „nie podlega rozliczeniu” – dla prowizji, zwrotów i przeksięgowań." />

                            <Button Content="Cofnij rozliczenie" Margin="0,0,0,10"
                                    Style="{StaticResource Wide}" Command="{Binding RevokeCommand}"
                                    ToolTip="Usuwa z ERP wszystkie rozliczenia tego zapisu i zwraca przelew do kolejki. Nieaktywne, gdy zapis nie jest w niczym rozliczony." />

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- =========================== status bar ========================== -->
        <Border Grid.Row="3" Margin="0,14,0,0" Padding="14,9" CornerRadius="6"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource Subtle}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0">
                    <Run Text="w kolejce " /><Run Text="{Binding QueueCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" przelewów na " /><Run
                        Text="{Binding QueueTotal, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                </TextBlock>

                <!-- Settling in bulk requires seeing what the whole set comes to. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasChecked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Subtle}" VerticalAlignment="Center">
                        <Run Text="zaznaczono " /><Run Text="{Binding CheckedCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" na " /><Run Text="{Binding CheckedTotal, Mode=OneWay, StringFormat={}{0:N2}}"
                                                FontWeight="SemiBold" />
                        <Run Text=" · do rozliczenia " /><Run
                            Text="{Binding CheckedAllocated, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                        <Run Text=" · różnica " /><Run
                            Text="{Binding CheckedDifference, Mode=OneWay, StringFormat={}{0:N2}}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>

                <ProgressBar Grid.Column="2" Width="140" Height="4" IsIndeterminate="True"
                             Margin="16,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
      </Grid>

      <!--
          The message goes above the content rather than in a bar at the bottom, where it went unseen.
          It fades by itself - the later, the worse the news. The colour and the glyph in the circle
          carry the severity; the styles do the rest.
      -->
      <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0"
              CornerRadius="10" Padding="14,11,10,11" MaxWidth="820" MinWidth="300"
              BorderThickness="1" Style="{StaticResource ToastCard}"
              Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}">
          <Border.Effect>
              <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.14" Color="#000000" />
          </Border.Effect>

          <Grid>
              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource ToastBadge}" Margin="0,1,11,0">
                  <TextBlock Text="{Binding ToastGlyph}" Foreground="White" FontSize="12"
                             FontWeight="SemiBold" HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
              </Border>

              <TextBox Grid.Column="1" Text="{Binding Status, Mode=OneWay}" MaxWidth="700"
                       Style="{StaticResource ToastText}" Margin="0,2,0,0" />

              <Button Grid.Column="2" Content="✕" Margin="12,0,0,0"
                      Style="{StaticResource ToastClose}" Click="OnHideToast" />
          </Grid>
      </Border>
    </Grid>
</Window>
