<Window x:Class="Gaska.Payments.Desktop.Views.IbanPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Dane banku – ibancalculator.com"
        Icon="/rozliczanie.ico"
        Width="900" Height="820"
        WindowStartupLocation="Manual"
        Background="{StaticResource Canvas}">

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Strona, z której przepisano dane" Style="{StaticResource H2}" Margin="0,0,0,2" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--
            Okno zostaje otwarte po przepisaniu danych - operator ma porównać je z formularzem.
            Zamyka się razem z formularzem banku (jest jego oknem podrzędnym) albo wtedy, gdy
            operator zamknie je sam.
        -->
        <wv2:WebView2 x:Name="Browser" />
    </DockPanel>
</Window>
