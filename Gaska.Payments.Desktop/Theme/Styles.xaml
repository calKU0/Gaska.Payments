<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mvvm="clr-namespace:Gaska.Payments.Desktop.Mvvm">

    <mvvm:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <mvvm:BoolToBrushConverter x:Key="BoolToBrush" />

    <!--
        Every style has a key and is applied explicitly. The Fluent theme (ThemeMode="Light") adds
        its own implicit styles after this dictionary, so a style without a key gets overridden -
        which is exactly how the column header alignment and the button look went astray.
    -->

    <!-- The palette. Light, calm, one accent - this is a tool for staring at numbers for
         eight hours, not for making an impression. -->
    <Color x:Key="CanvasColor">#F4F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E5EA</Color>
    <Color x:Key="TextColor">#171A20</Color>
    <Color x:Key="MutedColor">#6B7280</Color>
    <Color x:Key="AccentColor">#1D4ED8</Color>

    <SolidColorBrush x:Key="Canvas" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EEF3FF" />

    <SolidColorBrush x:Key="Good" Color="#15803D" />
    <SolidColorBrush x:Key="GoodSoft" Color="#ECFDF3" />
    <SolidColorBrush x:Key="Warn" Color="#B45309" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF7ED" />
    <SolidColorBrush x:Key="Bad" Color="#B91C1C" />
    <SolidColorBrush x:Key="BadSoft" Color="#FEF2F2" />

    <!-- ============================== typography ============================== -->

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="Subtle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
        Amounts to the right and in fixed-width figures (NumeralAlignment=Tabular), so that orders
        of magnitude can be compared by eye. Without changing the typeface - a separate font in one
        column looked like a foreign body.
    -->
    <Style x:Key="Money" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style x:Key="MoneyCell" TargetType="TextBlock" BasedOn="{StaticResource Money}">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!--
        Cells carry no padding, and their content only enough margin to keep the text off the
        column edge. The same value as in the header, so the columns line up to the pixel.
    -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="Margin" Value="9,0,5,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        Payment details get pasted into an email or into the ERP search box, so they have to be
        selectable. A plain TextBlock cannot do that - we use a read-only text box stripped of its
        frame so that it looks like text.
    -->
    <!--
        The context menu is not inherited, because the Fluent theme substitutes its own. Ours is
        short and in Polish, and it offers a way to copy the whole value in one move.
        x:Shared="False" - each field gets its own instance, or the menu follows a single one.
    -->
    <ContextMenu x:Key="CopyMenu" x:Shared="False">
        <MenuItem Command="ApplicationCommands.Copy" Header="Kopiuj" />
        <MenuItem Command="ApplicationCommands.SelectAll" Header="Zaznacz wszystko" />
    </ContextMenu>

    <!--
        A read-only field that can be selected and copied. The selection colour and caret visibility
        are set explicitly: without that the selection can be invisible and the field looks as though
        it were not responding at all.
    -->
    <Style x:Key="Selectable" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="ContextMenu" Value="{StaticResource CopyMenu}" />

        <!--
            A template of our own instead of the Fluent one. Fluent is still experimental in WPF (hence
            NoWarn WPF0001) and its text box can fail to pass the mouse through to the text layer - it
            looks as though the text cannot be selected. No decoration is needed here: this field exists
            only to be read and copied.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SelectableMono" TargetType="TextBox" BasedOn="{StaticResource Selectable}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
    </Style>

    <!-- ================================ toast ================================ -->
    <!--
        One message at a time, above the content, fading by itself. The colour carries the severity:
        white is plain information, green a confirmation, orange "look at this", red a failure. The
        shades are the ones the list uses on amounts, so that the application speaks with one voice.
    -->

    <Style x:Key="ToastCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                <Setter Property="Background" Value="{StaticResource GoodSoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource Good}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ToastKind}" Value="Warning">
                <Setter Property="Background" Value="{StaticResource WarnSoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                <Setter Property="Background" Value="{StaticResource BadSoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource Bad}" />
            </DataTrigger>

            <!-- It appears softly so as not to flash above the table. It plays on every showing. -->
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A circle with a glyph. The background shade alone can be barely visible; the glyph
         leaves no doubt. -->
    <Style x:Key="ToastBadge" TargetType="Border">
        <Setter Property="Width" Value="23" />
        <Setter Property="Height" Value="23" />
        <Setter Property="CornerRadius" Value="11.5" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{StaticResource Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                <Setter Property="Background" Value="{StaticResource Good}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ToastKind}" Value="Warning">
                <Setter Property="Background" Value="{StaticResource Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                <Setter Property="Background" Value="{StaticResource Bad}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A TextBox rather than a TextBlock: the document number in an error has to be copyable. -->
    <Style x:Key="ToastText" TargetType="TextBox" BasedOn="{StaticResource Selectable}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ToastKind}" Value="Success">
                <Setter Property="Foreground" Value="{StaticResource Good}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ToastKind}" Value="Warning">
                <Setter Property="Foreground" Value="{StaticResource Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ToastKind}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource Bad}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToastClose" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Zamknij komunikat" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background" Background="Transparent" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="#14000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Handles for moving the panel boundaries. The direction is set explicitly: with Stretch
        alignment on both axes WPF guesses it from the handle's proportions and can pick rows where
        columns are meant - dragging then does nothing.
    -->
    <Style x:Key="VerticalSplitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="10" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border x:Name="Underline" Width="2" CornerRadius="1"
                                Background="Transparent" Margin="0,10" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HorizontalSplitter" TargetType="GridSplitter">
        <Setter Property="Height" Value="10" />
        <Setter Property="ResizeDirection" Value="Rows" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border x:Name="Underline" Height="2" CornerRadius="1"
                                Background="Transparent" Margin="10,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================= cards ================================ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- =============================== buttons ================================ -->

    <!--
        A template of our own rather than setters alone: the look is then the same regardless of the
        system theme. The hover and pressed states are done by darkening, so one template serves both
        the white button and the accent-filled one.
    -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A toggle posing as a collapsed combo box - for the multiple-choice filters. -->
    <Style x:Key="Dropdown" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Background" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A multiple-choice filter: a button carrying the summary and a popup list of check boxes. An
        ordinary combo box will not do here - clicking an entry would close it and overwrite the text
        on the collapsed field. HeaderedItemsControl gives both at once: the header goes on the
        button, the entries inside. All four filters in the bar use this style, so they look and
        behave the same and are described once.
    -->
    <Style x:Key="MultiSelectFilter" TargetType="HeaderedItemsControl">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedItemsControl">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{StaticResource Dropdown}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Header}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="⌄" Margin="8,-4,0,0"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>

                        <!--
                            StaysOpen stays True on purpose: closing on an outside press is done by
                            DropdownPopup, which holds the mouse capture while the list is open. The
                            popup's own version of that closed the list on the very press the button
                            was about to act on, and the button then reopened it - the second click
                            appeared to do nothing.
                        -->
                        <Popup IsOpen="{Binding IsChecked, ElementName=Toggle}"
                               PlacementTarget="{Binding ElementName=Toggle}"
                               mvvm:DropdownPopup.Toggle="{Binding ElementName=Toggle}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                               VerticalOffset="4">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10"
                                    MinWidth="{Binding ActualWidth, ElementName=Toggle}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14" Color="#000000" />
                                </Border.Effect>
                                <!-- There can be a dozen registers and more, so the list has to be able to scroll. -->
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="Wide" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PrimaryWide" TargetType="Button" BasedOn="{StaticResource Primary}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ================================ grids ================================= -->

    <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F7F8FA" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="9,8" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                            <!--
                                A header template of our own lost the sort direction arrow the theme draws by itself -
                                without it a click leaves no sign of which way the list is sorted. The arrow is here and
                                lights up from SortDirection.
                            -->
                            <TextBlock x:Name="SortArrow" Grid.Column="1" Margin="6,0,0,0"
                                       VerticalAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource Accent}"
                                       Visibility="Collapsed" Text="▲" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="Text" Value="▲" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="Text" Value="▼" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The header of an amount column stands over numbers, so it goes to the right. The header
        content does that rather than a separate style - every header is then guaranteed the same
        font, background and border, because they all come from one style.
    -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="HeaderTextRight" TargetType="TextBlock" BasedOn="{StaticResource HeaderText}">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!--
        A cell with no padding. Padding clipped the content of templated columns - it showed most on
        the cut-off check boxes. The content styles supply the spacing instead.
    -->
    <Style x:Key="Cell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Table" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{StaticResource Surface}" />
        <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
        <Setter Property="HorizontalGridLinesBrush" Value="#F0F2F5" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <!--
            Without this a double click on a row starts cell editing. The columns are bound to read-only
            properties, so WPF brought the whole application down on it.
        -->
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ColumnHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource Cell}" />
    </Style>

</ResourceDictionary>
