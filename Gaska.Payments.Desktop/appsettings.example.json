{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Gaska.Payments": "Debug",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/rozliczanie-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 62,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rozliczanie-errors-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 62,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Erp": {
    "ConnectionString": "Server=<serwer>;Database=<baza>;User Id=<uzytkownik>;Password=<haslo>;TrustServerCertificate=True;Encrypt=True"
  },
  "Xl": {
    "ApiVersion": 20251,
    "Database": "<baza ERP>"
  },
  "Archive": {
    "Directory": "<sciezka do archiwum>"
  },
  "Settlement": {
    "Registers": [
      "FORPL",
      "FORUE",
      "FORUS",
      "FORRO",
      "FORVA",
      "K_GLS",
      "KARTA"
    ],
    "CardRegisters": [
      "KART1",
      "KART3",
      "KART4",
      "KART5",
      "FORKO",
      "FORKG"
    ],
    "PostOnlyRegisters": [
      "ZF\u015aS",
      "FORZU",
      "FORD2"
    ],
    "UncheckedRegisters": [
      "KART1",
      "KART3",
      "KART4",
      "KART5",
      "FORKO",
      "FORKG",
      "ZF\u015aS",
      "FORZU",
      "FORD2",
      "K_GLS",
      "KARTA",
      "FORVA"
    ]
  }
}
